// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

generator prismabox {
  provider                    = "prismabox"
  typeboxImportDependencyName = "elysia"
  typeboxImportVariableName   = "t"
  inputModel                  = true
  output                      = "../generated/prismabox"
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  email        String        @unique
  passwordHash String
  role         Role
  createdAt    DateTime      @default(now())
  services     Service[]
  appointments Appointment[]
}

model Service {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  type            Type
  providerId      User           @relation(fields: [userId], references: [id])
  durationMinutes Int
  createdAt       DateTime       @default(now())
  userId          String         @db.Uuid
  availabilities  Availability[]
  appointments    Appointment[]
}

model Availability {
  id        String  @id @default(uuid()) @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id])
  dayOfWeek Int
  startTime String
  endTime   String
  serviceId String  @db.Uuid
}

model Appointment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  ServiceId String   @db.Uuid
  service   Service  @relation(fields: [ServiceId], references: [id])
  date      String
  startTime String
  endTime   String
  slotId    String   @unique // but no slots table  `slotId` format: `<serviceId>_<YYYY-MM-DD>_<HH:MM>`
  status    Status
  createdAt DateTime @default(now())
}

enum Status {
  BOOKED
  CANCELLED
}

enum Type {
  MEDICAL
  HOUSE_HELP
  BEAUTY
  FITNESS
  EDUCATION
  OTHER
}

enum Role {
  USER
  SERVICE_PROVIDER
}
